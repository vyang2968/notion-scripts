{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notion-scripts",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-15",
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  // "observability": {
  //   "logs": {
  //     "enabled": true,
  //   },
  // },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "POSTHOG_HOST": "https://us.i.posthog.com",
  },
  // secrets (set via `wrangler secret put`):
  //   POSTHOG_API_KEY
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notion-scripts-db",
      "database_id": "dc3a1562-3031-4817-acfc-2771b431f24d"
    }
  ],
  // note: run `wrangler d1 migrations apply notion-scripts-db --remote`
  "ai": {
    "binding": "AI"
  },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
