{
  "name": "notion-scripts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "bun run typecheck && wrangler deploy --dry-run --minify",
    "deploy": "wrangler d1 migrations apply notion-scripts-db --remote && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:create": "wrangler d1 create notion-scripts-db",
    "db:migrate": "wrangler d1 migrations apply notion-scripts-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply notion-scripts-db --local",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@notionhq/client": "^5.21.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "hono": "^4.12.18",
    "postal-mime": "^2.7.5",
    "posthog-node": "^5.46.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260516.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.4.0"
  }
}
